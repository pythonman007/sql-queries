select  -- non-corelated 
  o.order_id , 
  o.user_id , 
  o.amount
from orders as o 
where o.amount > ( select avg(o1.amount) from orders as o1 ) -- scalar subquery 

select -- non-corelated subquery 
  u.user_id , 
  u.name 
from users as u 
where u.user_id in ( select distinct o.user_id from orders as o ) -- col subquery 

select -- co-related subquery 
  o.order_id , 
  ( select u.name  from users as u where o.user_id = u.user_id ) -- row subquery 
from orders as o 


select max(max_amount) -- non-corelated subquery 
from (select
  o.user_id , max(o.amount) as max_amount 
from orders as o 
group by o.user_id) as new_table  -- table subquery 


-- subquery with in 
-- scenario - 1 
select
  u.user_id , 
  u.name 
from users as u 
where u.user_id in ( select distinct o.user_id from orders as o )

-- scenario - 2 
select 
  o.user_id , 
  o.product_id
from orders as o 
where o.product_id in ( select product_id  from products where product = 'Tablet' ) 


-- exists 
-- scenario - 1 , scenario - 2 
select    -- 
  u.user_id , 
  u.name 
from users as u 
where exists(
  select 1
  from orders as o 
  where u.user_id = o.user_id and o.amount >= 500 
)

-- not exists 
-- scenario - 1 
select 
  u.user_id , 
  u.name 
from users as u 
where not exists(
  select 1
  from orders as o 
  where o.user_id = u.user_id   
)


select
  u.user_id , 
  u.name , 
  ( select max(o1.amount) from orders as o1 where u.user_id = o1.user_id) as max_amount 
from users as u
where u.user_id in ( select distinct o.user_id from orders as o )














